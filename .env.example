# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for sitemap, canonical URLs and OpenGraph). Domain is not yet acquired.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS (https://www.sanity.io/manage). Without these the site uses the seed content in lib/content/seed.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: read token, only needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that refreshes pages after publishing (POST /api/revalidate).
SANITY_REVALIDATE_SECRET=

# Supabase (form submissions). Service role key is server only. Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications for new form submissions)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Cheer the Kids <forms@yourdomain.org>"
RESEND_FROM=
# Where new submission notifications go. Defaults to the official email in lib/site.ts.
FORM_NOTIFY_TO=

# Paystack. Public key is safe in the browser; secret key is server only (used to verify payments).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
